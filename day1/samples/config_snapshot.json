{
  "artifact_type": "config_snapshot",
  "tenant": "NordicPay",
  "service": "payment-api",
  "environment": "demo",
  "captured_at": "2026-09-23T12:00:00Z",
  "schema_version": "0.1.0",
  "disclaimer": "Synthetic config for PayEvidence MVP demo. Not a production secret dump. No CHD.",
  "tls": {
    "min_version": "1.2",
    "versions_enabled": [
      "1.2",
      "1.3"
    ],
    "versions_disabled": [
      "SSLv3",
      "TLS1.0",
      "TLS1.1"
    ],
    "hsts_enabled": true,
    "cipher_policy": "modern"
  },
  "auth": {
    "rbac_enabled": true,
    "admin_mfa_required": true,
    "modes": [
      "oauth2_client_credentials",
      "jwt_short_lived",
      "mtls"
    ],
    "password_only_admin": false,
    "session_ttl_seconds": 3600,
    "api_key_legacy": false
  },
  "logging": {
    "enabled": true,
    "integrity_protection": true,
    "retention_days": 365,
    "security_event_sink": "siem://nordicpay-security",
    "fields_required": [
      "request_id",
      "actor_id",
      "path",
      "method",
      "status",
      "ip",
      "ts"
    ],
    "chd_scrubbing": true,
    "destinations": [
      "stdout",
      "central-siem"
    ]
  },
  "encryption": {
    "at_rest": {
      "enabled": true,
      "algorithm": "AES-256-GCM",
      "key_management": "cloud_kms_cmk"
    },
    "in_transit": {
      "enabled": true,
      "notes": "All external and inter-service payment traffic over TLS"
    },
    "tokens_only": true,
    "stores_raw_pan": false
  },
  "hardening": {
    "debug_endpoints_enabled": false,
    "default_credentials_allowed": false,
    "admin_panel_public": false,
    "cors_strict": true
  },
  "network": {
    "admin_public": false,
    "allowlist_or_private_ingress": true,
    "payment_tier": "private-subnet-eu-north",
    "egress_restricted": true
  },
  "time_sync": {
    "enabled": true,
    "ntp_or_equiv": "chrony/aws-time",
    "timezone": "UTC"
  },
  "change_management": {
    "require_approval_for_prod": true,
    "ticket_system": "linear-demo"
  }
}
